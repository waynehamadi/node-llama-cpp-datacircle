{
  "name": "@datacircle/node-llama-cpp",
  "version": "0.1.0",
  "description": "Functions for node-llama-cpp's LlamaChatSession that call Datacircle's open API. Use them to find the best GTM APIs. List every API and see which provider ranks first on each one. Search every provider's pricing plans. See where a provider ranks. No API key needed.",
  "keywords": [
    "node-llama-cpp",
    "llama-cpp",
    "llama.cpp",
    "gguf",
    "local-llm",
    "function-calling",
    "tool-calling",
    "functions",
    "gtm",
    "gtm-apis",
    "api",
    "api-directory",
    "api-pricing",
    "b2b-data",
    "data-enrichment",
    "datacircle"
  ],
  "homepage": "https://datacircle.dev",
  "bugs": {
    "url": "https://github.com/waynehamadi/node-llama-cpp-datacircle/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waynehamadi/node-llama-cpp-datacircle.git"
  },
  "license": "MIT",
  "author": "Datacircle <wayne@datacircle.dev> (https://datacircle.dev)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "npm run build && node test/live.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "node-llama-cpp": ">=3.0.0"
  },
